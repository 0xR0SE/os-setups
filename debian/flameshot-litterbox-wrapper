#!/bin/bash

# 1. Capture the X11 screen area cleanly
TMP_FILE=$(mktemp /tmp/screenshot.XXXXXX.png)
flameshot gui --raw > "$TMP_FILE"

# Clean exit if the selection was aborted
if [ ! -s "$TMP_FILE" ]; then
    rm -f "$TMP_FILE"
    exit 0
fi

# 2. Upload to Litterbox (Expires in 1 hour)
RESPONSE=$(curl -s \
  -F "reqtype=fileupload" \
  -F "time=1h" \
  -F "fileToUpload=@$TMP_FILE" \
  https://litterbox.catbox.moe/resources/internals/api.php)

# 3. Copy clean link to X11 clipboard
if [[ "$RESPONSE" =~ ^https:// ]]; then
    if command -v xclip &> /dev/null; then
        echo -n "$RESPONSE" | xclip -selection clipboard
    fi
fi

# Clean up
rm -f "$TMP_FILE"
